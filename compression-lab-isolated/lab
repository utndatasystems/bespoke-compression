#!/usr/bin/env python3
"""Project-local entry point; no global installation required."""
import os
from pathlib import Path
import sys

root = Path(__file__).resolve().parent
venv = root / ".venv/bin/python"
if venv.exists() and Path(sys.prefix) != root / ".venv":
    os.execv(str(venv), [str(venv), __file__, *sys.argv[1:]])
sys.path.insert(0, str(root / "src"))
from lab_interface.cli import main

main()
